rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Lots subcollection
      match /lots/{lotId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Sales subcollection within lots
        match /sales/{saleId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Settings document
      match /settings/preferences {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
