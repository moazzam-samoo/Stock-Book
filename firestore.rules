rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Lots subcollection
      match /lots/{lotId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Sales subcollection within lots
        match /sales/{saleId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Positions subcollection
      match /positions/{positionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Profit withdrawals subcollection
      match /withdrawals/{withdrawalId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Settings document
      match /settings/preferences {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Price alerts subcollection (buy-side watchlist, Phase 07)
      match /price_alerts/{alertId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Market prices — top-level, shared across all users. Only the backend
    // (Admin SDK, which bypasses these rules) writes here; no client write
    // rule is deliberate, so a client can never forge a price.
    match /market_prices/{ticker} {
      allow read: if request.auth != null;
    }

    // Market status — same pattern as market_prices: top-level, read-only,
    // only the backend (Admin SDK) writes here.
    match /market_status/{doc} {
      allow read: if request.auth != null;
    }

    // Tickers reference list (Phase 08 Task 7 / Phase 09) — same pattern:
    // top-level, read-only, only the backend (Admin SDK) writes here.
    match /tickers/{doc} {
      allow read: if request.auth != null;
    }

    // Premium unlock codes (Pin Stocks feature). Codes are created only by
    // the Admin SDK (scripts/generate_premium_codes.py) — no client
    // create/delete. `allow get` (not `allow read`) deliberately: a client
    // can look up one exact code by ID, but can never `list`/enumerate the
    // collection to guess or scrape valid codes. `allow update` only ever
    // flips an unredeemed code to redeemed-by-me — nothing else about the
    // doc can be changed by a client, and a code that's already redeemed
    // (by anyone) can never be updated again.
    match /premium_codes/{code} {
      allow get: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.redeemed == false
        && request.resource.data.redeemed == true
        && request.resource.data.redeemedBy == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
