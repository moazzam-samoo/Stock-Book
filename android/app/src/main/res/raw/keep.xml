<?xml version="1.0" encoding="utf-8"?>
<!--
  Android's release-build resource shrinker only sees resources referenced
  statically from compiled Java/Kotlin/XML — it has no visibility into
  RawResourceAndroidNotificationSound('stock_alert') in Dart, which is a
  plain string literal from its point of view. Without this file, the
  shrinker concludes raw/stock_alert.wav is unused and strips it from every
  release APK, so notifications.show() throws
  PlatformException(invalid_sound, ...) at runtime — the notification is
  built and the call is made, but the OS call to display it fails, silently
  swallowed by the catch block around it. See:
  https://developer.android.com/build/shrink-code#keep-resources
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/stock_alert" />
